{
	"luci-app-homeproxy": {
		"description": "Grant access to homeproxy configuration (v2: adds sing-box-core.json read)",
		"read": {
			"file": {
				"/etc/homeproxy/scripts/update_subscriptions.uc": [ "exec" ],
				"/etc/homeproxy/scripts/update_custom_config.uc": [ "exec" ],
				"/etc/homeproxy/custom/*": [ "read", "list" ],
				"/etc/homeproxy/custom/.subscriptions/*": [ "read", "list" ],
				"/var/run/homeproxy/homeproxy.log": [ "read" ],
				"/var/run/homeproxy/sing-box-c.log": [ "read" ],
				"/var/run/homeproxy/sing-box-s.log": [ "read" ],
				"/var/run/homeproxy/sing-box-core.json": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci.homeproxy": [ "*" ],
				"rc": [ "init" ]
			},
			"uci": [ "homeproxy" ]
		},
		"write": {
			"file": {
				"/tmp/homeproxy_certificate.tmp": [ "write" ],
				"/etc/homeproxy/custom/*": [ "write", "remove" ],
				"/etc/homeproxy/custom/.subscriptions/*": [ "write", "remove" ]
			},
			"uci": [ "homeproxy" ]
		}
	}
}


